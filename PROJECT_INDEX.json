      "files": [
        {
          "path": "Source/Common/types/Types.h",
          "description": "Estructuras de datos compartidas: TrackTelemetry, SlotInfo, BusType, MentorMessage, MentorPhase, Achievement",
          "keywords": ["types", "estructuras", "BusType", "SlotInfo", "TrackTelemetry", "enums", "bus", "fases"]
        },
        {
          "path": "Source/Common/types/Constants.h",
          "description": "Constantes globales: límites del sistema, colores de bus, niveles de referencia",
          "keywords": ["constantes", "limites", "kMaxTracks", "kFFTSize", "colores bus", "kHeadroomTarget"]
        },
        {
          "path": "Source/Common/memory/SharedData.h",
