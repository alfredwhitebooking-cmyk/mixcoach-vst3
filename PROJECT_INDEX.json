          "keywords": ["shared data", "singleton", "IPC bridge", "getInstance", "slot registry"]
        },
        {
          "path": "Source/Common/memory/SharedMemory.h",
          "description": "Memoria compartida entre procesos via Windows CreateFileMappingW. SharedSlotEntry, SharedMemoryBlock, SharedMemoryManager con spinlock",
          "keywords": ["shared memory", "CreateFileMappingW", "IPC", "spinlock", "interprocess", "file mapping"]
        },
        {
          "path": "Source/Common/memory/SlotRegistry.h",
