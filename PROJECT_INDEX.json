          "keywords": ["FFT", "RMS", "phase correlation", "spectrum", "audio analysis", "dsp"]
        },
        {
          "path": "Source/Common/types/TelemetryData.h",
          "description": "Buffers circulares lock-free: TelemetryBuffer y AudioRingBuffer para IPC thread-safe",
          "keywords": ["ring buffer", "lock-free", "telemetry buffer", "audio buffer", "circular buffer"]
        },
        {
